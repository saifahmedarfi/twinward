{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProPS-Twin estate event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp", "event_id", "experiment_id", "scenario_id", "component",
    "event_type", "severity", "simulated_state", "zone", "policy_version", "details"
  ],
  "properties": {
    "timestamp": { "type": "string" },
    "event_id": { "type": "string", "minLength": 8 },
    "experiment_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "component": { "type": "string" },
    "event_type": { "type": "string" },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "simulated_state": { "type": "string", "enum": ["normal", "anomalous", "fault", "violation"] },
    "zone": { "type": "string", "enum": ["enterprise", "idmz", "supervisory", "control", "field"] },
    "policy_version": { "type": "string" },
    "details": { "type": "object" }
  }
}
